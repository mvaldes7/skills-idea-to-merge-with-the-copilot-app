<section class="manager" aria-label="Bookmark manager">
  <div class="intro">
    <p class="eyebrow">YOUR PERSONAL LINK LIBRARY</p>
    <p class="intro-copy">A tidy place for the pages you want to find again.</p>
  </div>

  <form id="add-bookmark" class="bookmark-form">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        aria-describedby="url-hint form-status"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p id="url-hint" class="hint">Paste a URL with or without <code>https://</code>.</p>
  <p id="form-status" class="status" role="status" aria-live="polite"></p>

  <p id="empty-state" class="empty">
    <span class="empty-mark" aria-hidden="true">✳</span>
    <span>No bookmarks yet</span>
    <span class="empty-note">Your saved links will show up here.</span>
  </p>

  <div id="list-header" class="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" class="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
    <!-- Bookmarks render here in the browser. -->
  </ul>
</section>

<script>
  import {
    formatBookmark,
    generateSlug,
    normalizeUrl,
    parseStoredBookmarks,
  } from '../lib/bookmarks.js';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const status = document.getElementById('form-status');
  const clearButton = document.getElementById('clear-all');

  function report(message) {
    if (status) status.textContent = message;
  }

  function loadBookmarks() {
    try {
      return parseStoredBookmarks(window.localStorage.getItem(storageKey));
    } catch {
      report('Saved bookmarks could not be read from this browser.');
      return [];
    }
  }

  function saveBookmarks(nextBookmarks) {
    try {
      window.localStorage.setItem(storageKey, JSON.stringify(nextBookmarks));
      return true;
    } catch {
      report('This browser could not save your bookmark. Please try again.');
      return false;
    }
  }

  function renderBookmarks(bookmarks) {
    if (!list || !emptyState || !listHeader) return;

    list.replaceChildren();
    emptyState.hidden = bookmarks.length > 0;
    listHeader.hidden = bookmarks.length === 0;

    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const summary = document.createElement('div');
      summary.className = 'bookmark-summary';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      summary.append(link, document.createTextNode(' :: '), slug);

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          report(`Copied ${bookmark.slug}.`);
        } catch {
          report('The slug could not be copied from this browser.');
        }
      });

      item.append(summary, copyButton);
      item.setAttribute('aria-label', formatBookmark(bookmark));
      list.append(item);
    }
  }

  let bookmarks = loadBookmarks();
  renderBookmarks(bookmarks);

  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      const url = normalizeUrl(input?.value ?? '');
      let slug;
      for (let attempt = 0; attempt < 100; attempt += 1) {
        const candidate = generateSlug();
        if (!bookmarks.some((bookmark) => bookmark.slug === candidate)) {
          slug = candidate;
          break;
        }
      }
      if (!slug) {
        report('A unique slug could not be generated. Please try again.');
        return;
      }

      const nextBookmarks = [...bookmarks, { url, slug }];
      if (!saveBookmarks(nextBookmarks)) return;

      bookmarks = nextBookmarks;
      renderBookmarks(bookmarks);
      if (input) input.value = '';
      report('Bookmark saved.');
    } catch {
      report('Enter a valid web URL, such as example.com.');
    }
  });

  clearButton?.addEventListener('click', () => {
    if (!window.confirm('Clear all saved bookmarks?')) return;
    try {
      window.localStorage.removeItem(storageKey);
      bookmarks = [];
      renderBookmarks(bookmarks);
      report('All bookmarks cleared.');
    } catch {
      report('Bookmarks could not be cleared from this browser.');
    }
  });
</script>

<style>
  .manager {
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    background: color-mix(in srgb, currentColor 3%, transparent);
    box-shadow: 0 1.25rem 3rem color-mix(in srgb, currentColor 7%, transparent);
  }

  .intro { margin-bottom: 1.25rem; }
  .eyebrow {
    margin: 0 0 0.25rem;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .intro-copy { margin: 0; color: var(--muted); font-size: 0.9rem; }

  .bookmark-form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.65rem;
    margin: 0;
  }
  .field { flex: 1 1 14rem; }
  .field label { font-size: 0.8rem; }
  .field input { width: 100%; }
  .bookmark-form button { min-height: 2.75rem; }
  .hint { margin: 0.55rem 0 0; color: var(--muted); font-size: 0.75rem; }
  .hint code { color: inherit; }
  .status {
    min-height: 1.25rem;
    margin: 0.45rem 0 0;
    color: var(--muted);
    font-size: 0.75rem;
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    margin: 1rem 0 0;
    padding: 1.8rem 1rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--muted);
    text-align: center;
  }
  .empty[hidden] { display: none; }
  .empty-mark { color: var(--accent); font-size: 1.35rem; }
  .empty-note { font-size: 0.75rem; }

  .list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 1rem 0 0.55rem;
  }
  .list-header[hidden] { display: none; }
  .list-title { margin: 0; font-family: var(--font-head); font-size: 1rem; }
  .clear,
  .copy {
    padding: 0.35rem 0.65rem;
    border-color: var(--border);
    background: transparent;
    color: inherit;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .clear:hover,
  .copy:hover { border-color: currentColor; }

  .bookmark-list { list-style: none; display: grid; gap: 0.5rem; margin: 0; padding: 0; }
  .bookmark {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, currentColor 2%, transparent);
  }
  .bookmark-summary { min-width: 0; overflow-wrap: anywhere; }
  .url { color: inherit; }
  .slug {
    display: inline-block;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    font-family: var(--font-body);
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .copy { flex: 0 0 auto; }

  @media (max-width: 34rem) {
    .manager { padding: 1rem; }
    .bookmark { align-items: flex-start; }
    .bookmark-form button { width: 100%; }
  }
</style>
